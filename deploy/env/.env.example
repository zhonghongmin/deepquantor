# 环境变量模板（.env.example）
#
# 规则（NFR-07 / NFR-12）：
#   - 本文件是模板，可入库；实际 .env 不入库（已在 .gitignore）
#   - 凭证只在 offline-node 存在；线上库不保存线下库地址与账号
#   - 运行时路径经 env 注入，应用内不硬编码绝对路径
#
# 用法：cp .env.example .env 后填入实际值。

# ── 线下 PostgreSQL（写权威，仅 offline-node）────────────────────────
OFFLINE_PG_HOST=127.0.0.1
OFFLINE_PG_PORT=5432
OFFLINE_PG_DB=deepquantor
OFFLINE_PG_USER=
OFFLINE_PG_PASSWORD=

# ── 线上 PostgreSQL（展示库；只读结果副本 + 用户域写）────────────────
ONLINE_PG_HOST=
ONLINE_PG_PORT=5432
ONLINE_PG_DB=deepquantor_web
ONLINE_PG_USER=
ONLINE_PG_PASSWORD=

# ── Redis（线下缓存；不存业务持久化数据）────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 数据源凭证（仅 offline-node；不入库、不入日志）────────────────────
# AKSHARE_TOKEN=
# TUSHARE_TOKEN=
# WIND_ACCOUNT=
# WIND_PASSWORD=

# ── 运行时路径（禁止硬编码绝对路径，统一由此注入）────────────────────
DQ_RUNTIME_DIR=D:/develop
DQ_LOG_DIR=D:/develop/logs
DQ_DATA_DIR=D:/develop/data
